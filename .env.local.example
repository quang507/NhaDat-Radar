NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role: chỉ cho crawler/seed chạy ở máy/VPS, KHÔNG đặt vào biến NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# URL site để OAuth redirect đúng (dev: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (Gemini) — cho webhook Zalo OA + trích field crawler
GEMINI_API_KEY=AIza...
# Bản đồ (tùy chọn — không có thì dùng OpenStreetMap miễn phí)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Zalo OA (đăng ký tại oa.zalo.me -> lấy các giá trị này)
ZALO_APP_ID=
ZALO_OA_SECRET=
ZALO_OA_ACCESS_TOKEN=
# Đặt =1 để bỏ verify chữ ký khi test local (production để trống)
ZALO_SKIP_VERIFY=

# Facebook qua Apify (crawler/facebook.mjs --apify-run + daily.mjs)
APIFY_TOKEN=apify_api_...
FB_GROUP_URLS=["https://www.facebook.com/groups/xxxx","https://www.facebook.com/groups/yyyy"]
FB_POSTS=30
